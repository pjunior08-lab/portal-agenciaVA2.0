# Copie para .env.local e preencha. NUNCA envie .env.local ao GitHub.
# Supabase › Project Settings › API

# Públicas (podem ir ao navegador; o acesso é limitado pelas políticas RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secreta (só servidor; usada a partir da Fase 1; configure no Netlify, nunca com prefixo NEXT_PUBLIC_)
# SUPABASE_SECRET_KEY=sb_secret_...

# Publicação automática no Instagram/Facebook (só no servidor; nunca NEXT_PUBLIC_)
# App criado em developers.facebook.com pela agência
META_APP_ID=
META_APP_SECRET=
# ID da configuração do "Login do Facebook para Empresas" (opcional, recomendado)
META_CONFIG_ID=
# Opcional: versão da API da Meta (padrão v23.0)
# META_GRAPH_VERSION=v23.0
# 32 bytes aleatórios em base64 (openssl rand -base64 32): criptografa as chaves de acesso das contas
SOCIAL_TOKEN_KEY=
# Mesmo valor do segredo "social_cron_secret" guardado no cofre (Vault) do Supabase
SOCIAL_CRON_SECRET=
